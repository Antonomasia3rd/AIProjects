# Discord application
DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me

# Development server. Commands deploy here instantly.
DISCORD_GUILD_ID=replace_me

# Supabase Shared Pooler -> Session mode (port 5432)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true

# Unique per physical machine/process host.
NODE_ID=change-me

# Cluster behavior
CLUSTER_ENABLED=true
CLUSTER_LEASE_MS=20000
CLUSTER_RENEW_MS=5000
CLUSTER_STANDBY_POLL_MS=4000
CLUSTER_FAILSAFE_MS=10000

# Default message retention for guilds that don't have an explicit DB setting.
# 0 = forever.
MESSAGE_CACHE_RETENTION_DAYS=0

LOG_LEVEL=info

# Startup history catch-up. Existing installs can omit these; defaults are shown.
STARTUP_CATCHUP_ENABLED=true
STARTUP_BOOTSTRAP_MESSAGES=100

# Remote computer control. The worker runs on EVERY HA node, including standbys.
COMPUTER_CONTROL_ENABLED=true
# Optional comma-separated Discord user IDs. If blank, Discord Administrator permission is the gate.
COMPUTER_CONTROL_USER_IDS=
COMPUTER_AGENT_POLL_MS=2000
COMPUTER_AGENT_HEARTBEAT_MS=5000


# Independent voice HA. Every Nifibot node may be a voice candidate even when
# it is NOT the Discord command/logging leader. Exactly one node owns the voice lease.
VOICE_HA_ENABLED=true
VOICE_LEASE_MS=12000
VOICE_RENEW_MS=3000
VOICE_STANDBY_POLL_MS=2000
VOICE_FAILSAFE_MS=7000
VOICE_READY_TIMEOUT_MS=6000
# Avoid identifying the full gateway client and the voice-only client simultaneously.
VOICE_AGENT_START_DELAY_MS=6000
