{
  "name": "discord-ha-bot-starter",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:offline",
    "test:offline": "tsc -p tsconfig.json --outDir .offline-tests --sourceMap false && node --test --test-timeout=10000 tests/offline.test.mjs",
    "start": "node dist/watchdog.js",
    "commands:deploy": "tsx src/scripts/deployCommands.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "startup:install": "tsx src/scripts/startup.ts install",
    "startup:status": "tsx src/scripts/startup.ts status",
    "startup:remove": "tsx src/scripts/startup.ts remove",
    "start:direct": "node dist/index.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.19.2",
    "dotenv": "^17.2.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
